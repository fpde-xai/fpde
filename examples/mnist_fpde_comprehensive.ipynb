        "selected_attr, selected_details = engine.explain_batch(X_test[:8], lambda_hyb=selection.best_lambda)\n",
        "assert selected_attr.shape == (8, X_train.shape[1])\n",
        "assert all(detail[\"lambda_hyb\"] == selection.best_lambda for detail in selected_details)\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(7.5, 3.2))\n",
        "show_digit(x, title=\"sample\", ax=axes[0])\n",
        "show_attribution(selected_attr[0], title=f\"selected lambda={selection.best_lambda}\", ax=axes[1])\n",
        "fig.tight_layout()"
      ]
    },
