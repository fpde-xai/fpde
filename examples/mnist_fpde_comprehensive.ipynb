      "source": [
        "def mean_abs_nan_safe(values):\n",
        "    arr = pd.to_numeric(values, errors=\"coerce\").to_numpy(dtype=float)\n",
        "    arr = arr[np.isfinite(arr)]\n",
        "    return float(np.mean(np.abs(arr))) if arr.size else float(\"nan\")\n",
        "\n",
        "\n",
        "ok = per_instance[per_instance[\"status\"] == \"ok\"].copy()\n",
        "summary_by_method = ok.groupby(\"method\", as_index=False).agg(\n",
        "    mean_deletion_drop_auc=(\"deletion_drop_auc\", \"mean\"),\n",
        "    std_deletion_drop_auc=(\"deletion_drop_auc\", \"std\"),\n",
        "    mean_insertion_auc=(\"insertion_auc\", \"mean\"),\n",
        "    std_insertion_auc=(\"insertion_auc\", \"std\"),\n",
        "    mean_combined_score=(\"combined_score\", \"mean\"),\n",
        "    std_combined_score=(\"combined_score\", \"std\"),\n",
        "    mean_runtime_seconds=(\"runtime_seconds\", \"mean\"),\n",
        "    std_runtime_seconds=(\"runtime_seconds\", \"std\"),\n",
        "    mean_attr_l1_norm=(\"attr_l1_norm\", \"mean\"),\n",
        "    mean_abs_exactness_residual=(\"exactness_residual\", mean_abs_nan_safe),\n",
        "    completed_instances=(\"combined_score\", \"count\"),\n",
        "    mean_test_accuracy=(\"test_accuracy\", \"mean\"),\n",
        ").sort_values(\"mean_combined_score\", ascending=False)\n",
        "\n",
        "status_counts = per_instance.groupby([\"method\", \"status\"]).size().unstack(fill_value=0).reset_index()\n",
        "summary_by_method = summary_by_method.merge(status_counts, on=\"method\", how=\"left\")\n",
        "summary_by_method"
      ]
    },
