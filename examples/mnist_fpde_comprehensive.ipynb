      "source": [
        "METHODS = (\"diff_fpde\", \"cos_fpde\", \"hyb_fpde_grid\")\n",
        "test_accuracy = float(accuracy_score(y_test, test_pred))\n",
        "baseline = engine.baseline\n",
        "\n",
        "\n",
        "def explain_fpde_method(method, sample):\n",
        "    target, rival, _ = top_two_labels(model, sample)\n",
        "    if method == \"diff_fpde\":\n",
        "        exp = explain_with_selected_prototypes(\n",
        "            sample,\n",
        "            prototypes,\n",
        "            prototype_labels,\n",
        "            positive_label=target,\n",
        "            negative_label=rival,\n",
        "            mode=\"diff\",\n",
        "        )\n",
        "        detail = {\n",
        "            \"target_label\": exp.positive_label,\n",
        "            \"rival_label\": exp.negative_label,\n",
        "            \"evidence\": exp.evidence,\n",
        "            \"lambda_hyb\": np.nan,\n",
        "            \"exactness_residual\": exp.exactness_residual,\n",
        "        }\n",
        "        return exp.attributions, detail\n",
        "    if method == \"cos_fpde\":\n",
        "        exp = explain_with_selected_prototypes(\n",
        "            sample,\n",
        "            prototypes,\n",
        "            prototype_labels,\n",
        "            positive_label=target,\n",
        "            negative_label=rival,\n",
        "            mode=\"cos\",\n",
        "            anchor=anchor,\n",
        "        )\n",
        "        detail = {\n",
        "            \"target_label\": exp.positive_label,\n",
        "            \"rival_label\": exp.negative_label,\n",
        "            \"evidence\": exp.evidence,\n",
        "            \"lambda_hyb\": np.nan,\n",
        "            \"exactness_residual\": exp.exactness_residual,\n",
        "        }\n",
        "        return exp.attributions, detail\n",
        "    if method == \"hyb_fpde_grid\":\n",
        "        attr, detail = engine.explain_one(sample, lambda_hyb=selection.best_lambda)\n",
        "        return attr, detail\n",
        "    raise ValueError(f\"unknown method: {method}\")\n",
        "\n",
        "\n",
        "def attribution_metrics(sample, attr, target_label):\n",
        "    curves = perturbation_curves(model, sample, attr, target_label, baseline, fractions=FRACTIONS)\n",
        "    return {\n",
        "        \"p0\": float(curves[\"p0\"]),\n",
        "        \"deletion_auc\": float(curves[\"deletion_auc\"]),\n",
        "        \"deletion_drop_auc\": float(curves[\"deletion_drop_auc\"]),\n",
        "        \"insertion_auc\": float(curves[\"insertion_auc\"]),\n",
        "        \"combined_score\": float(curves[\"combined_score\"]),\n",
        "    }\n",
        "\n",
        "\n",
        "per_instance_rows = []\n",
        "for explained_order, explained_index in enumerate(range(min(N_EXPLAIN, X_test.shape[0]))):\n",
        "    sample = X_test[explained_index]\n",
        "    true_label = int(y_test[explained_index])\n",
        "    pred_proba = np.asarray(model.predict_proba(sample.reshape(1, -1))[0], dtype=float)\n",
        "    pred_label = int(model.classes_[int(np.argmax(pred_proba))])\n",
        "\n",
        "    for method in METHODS:\n",
        "        start = time.perf_counter()\n",
        "        status = \"ok\"\n",
        "        error = \"\"\n",
        "        attr_l1_norm = float(\"nan\")\n",
        "        evidence = float(\"nan\")\n",
        "        lambda_hyb = float(\"nan\")\n",
        "        exactness_residual = float(\"nan\")\n",
        "        metrics = {name: float(\"nan\") for name in (\"p0\", \"deletion_auc\", \"deletion_drop_auc\", \"insertion_auc\", \"combined_score\")}\n",
        "        target_label_for_eval = pred_label\n",
        "\n",
        "        try:\n",
        "            attr, detail = explain_fpde_method(method, sample)\n",
        "            attr = np.asarray(attr, dtype=float)\n",
        "            if attr.shape != sample.shape:\n",
        "                raise ValueError(f\"attribution shape {attr.shape} differs from sample shape {sample.shape}\")\n",
        "            if not np.all(np.isfinite(attr)):\n",
        "                raise ValueError(\"attribution contains NaN or infinity\")\n",
        "            target_label_for_eval = int(detail[\"target_label\"])\n",
        "            evidence = float(detail.get(\"evidence\", np.nan))\n",
        "            lambda_hyb = float(detail.get(\"lambda_hyb\", np.nan))\n",
        "            exactness_residual = float(detail.get(\"exactness_residual\", np.nan))\n",
        "            attr_l1_norm = float(np.sum(np.abs(attr)))\n",
        "            metrics = attribution_metrics(sample, attr, target_label_for_eval)\n",
        "        except Exception as exc:\n",
        "            status = \"error\"\n",
        "            error = f\"{type(exc).__name__}: {exc}\"\n",
        "\n",
        "        elapsed = float(time.perf_counter() - start)\n",
        "        target_col = int(np.where(model.classes_ == target_label_for_eval)[0][0]) if target_label_for_eval in model.classes_ else int(np.argmax(pred_proba))\n",
        "        per_instance_rows.append(\n",
        "            {\n",
        "                \"task_id\": \"mnist_784_subset\",\n",
        "                \"dataset_name\": \"mnist_784\",\n",
        "                \"method\": method,\n",
        "                \"status\": status,\n",
        "                \"error\": error,\n",
        "                \"explained_index\": int(explained_index),\n",
        "                \"explained_order\": int(explained_order),\n",
        "                \"n_features_transformed\": int(X_train.shape[1]),\n",
        "                \"n_train_fit\": int(X_train.shape[0]),\n",
        "                \"n_val\": int(X_val.shape[0]),\n",
        "                \"n_test\": int(X_test.shape[0]),\n",
        "                \"n_classes\": int(len(model.classes_)),\n",
        "                \"true_label_encoded\": true_label,\n",
        "                \"pred_label_encoded\": pred_label,\n",
        "                \"target_label_encoded\": int(target_label_for_eval),\n",
        "                \"pred_target_probability\": float(pred_proba[target_col]),\n",
        "                \"runtime_seconds\": elapsed,\n",
        "                \"attr_l1_norm\": attr_l1_norm,\n",
        "                \"evidence\": evidence,\n",
        "                \"lambda_hyb\": lambda_hyb,\n",
        "                \"exactness_residual\": exactness_residual,\n",
        "                \"test_accuracy\": test_accuracy,\n",
        "                **metrics,\n",
        "            }\n",
        "        )\n",
        "\n",
        "per_instance = pd.DataFrame(per_instance_rows)\n",
        "per_instance.head(12)"
      ]
    },
