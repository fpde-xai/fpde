      "source": [
        "target_proto_idx = int(np.flatnonzero(prototype_labels == target_label)[0])\n",
        "rival_proto_idx = int(np.flatnonzero(prototype_labels == rival_label)[0])\n",
        "anchor = np.mean(X_train, axis=0)\n",
        "\n",
        "diff_exp = diff_fpde(\n",
        "    x,\n",
        "    prototypes[target_proto_idx],\n",
        "    prototypes[rival_proto_idx],\n",
        "    positive_label=target_label,\n",
        "    negative_label=rival_label,\n",
        "    positive_prototype_index=target_proto_idx,\n",
        "    negative_prototype_index=rival_proto_idx,\n",
        ")\n",
        "cos_exp = cos_fpde(\n",
        "    x,\n",
        "    prototypes[target_proto_idx],\n",
        "    prototypes[rival_proto_idx],\n",
        "    anchor=anchor,\n",
        "    positive_label=target_label,\n",
        "    negative_label=rival_label,\n",
        "    positive_prototype_index=target_proto_idx,\n",
        "    negative_prototype_index=rival_proto_idx,\n",
        ")\n",
        "selected_diff = explain_with_selected_prototypes(\n",
        "    x,\n",
        "    prototypes,\n",
        "    prototype_labels,\n",
        "    positive_label=target_label,\n",
        "    negative_label=rival_label,\n",
        "    mode=\"diff\",\n",
        ")\n",
        "selected_cos = explain_with_selected_prototypes(\n",
        "    x,\n",
        "    prototypes,\n",
        "    prototype_labels,\n",
        "    positive_label=target_label,\n",
        "    negative_label=rival_label,\n",
        "    mode=\"cos\",\n",
        "    anchor=anchor,\n",
        ")\n",
        "\n",
        "summary = pd.DataFrame(\n",
        "    [\n",
        "        {\"api\": \"diff_fpde\", \"mode\": diff_exp.mode, \"evidence\": diff_exp.evidence, \"residual\": diff_exp.exactness_residual},\n",
        "        {\"api\": \"cos_fpde\", \"mode\": cos_exp.mode, \"evidence\": cos_exp.evidence, \"residual\": cos_exp.exactness_residual},\n",
        "        {\"api\": \"explain_with_selected_prototypes diff\", \"mode\": selected_diff.mode, \"evidence\": selected_diff.evidence, \"residual\": selected_diff.exactness_residual},\n",
        "        {\"api\": \"explain_with_selected_prototypes cos\", \"mode\": selected_cos.mode, \"evidence\": selected_cos.evidence, \"residual\": selected_cos.exactness_residual},\n",
        "    ]\n",
        ")\n",
        "summary"
      ]
    },
