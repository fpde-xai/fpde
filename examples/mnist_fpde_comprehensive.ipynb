        "    .groupby(\"lambda_hyb\", as_index=False)\n",
        "    .agg(mean_score=(\"score\", \"mean\"), n_rows=(\"score\", \"count\"))\n",
        "    .sort_values(\"lambda_hyb\")\n",
        ")\n",
        "\n",
        "selected_lambda_counts = (\n",
        "    lambda_distribution[[\"selected_lambda\"]]\n",
        "    .drop_duplicates()\n",
        "    .value_counts(\"selected_lambda\")\n",
        "    .sort_index()\n",
        "    .reset_index(name=\"count\")\n",
        "    .rename(columns={\"selected_lambda\": \"lambda\"})\n",
        ")\n",
        "selected_lambda_counts[\"percentage\"] = selected_lambda_counts[\"count\"] / selected_lambda_counts[\"count\"].sum() * 100.0\n",
        "\n",
        "display(lambda_score_table)\n",
        "display(selected_lambda_counts)"
