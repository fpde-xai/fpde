   "source": [
    "def as_image(vector):\n",
    "    return np.asarray(vector, dtype=float).reshape(28, 28)\n",
    "\n",
    "\n",
    "def show_digit(vector, *, title=None, ax=None, cmap=\"gray\"):\n",
    "    if ax is None:\n",
    "        _, ax = plt.subplots(figsize=(3, 3))\n",
    "    ax.imshow(as_image(vector), cmap=cmap, interpolation=\"nearest\")\n",
    "    ax.set_xticks([])\n",
    "    ax.set_yticks([])\n",
    "    if title is not None:\n",
    "        ax.set_title(title)\n",
    "    return ax\n",
    "\n",
    "\n",
    "def show_attribution(attributions, *, title=None, ax=None):\n",
    "    values = as_image(attributions)\n",
    "    max_abs = float(np.max(np.abs(values)))\n",
    "    if max_abs == 0.0 or not np.isfinite(max_abs):\n",
    "        max_abs = 1.0\n",
    "    if ax is None:\n",
    "        _, ax = plt.subplots(figsize=(3.4, 3))\n",
    "    image = ax.imshow(values, cmap=\"coolwarm\", vmin=-max_abs, vmax=max_abs, interpolation=\"nearest\")\n",
    "    ax.set_xticks([])\n",
    "    ax.set_yticks([])\n",
    "    if title is not None:\n",
    "        ax.set_title(title)\n",
    "    plt.colorbar(image, ax=ax, fraction=0.046, pad=0.04)\n",
    "    return ax\n",
    "\n",
    "\n",
    "def top_pixels(attributions, k=12):\n",
    "    attr = np.asarray(attributions, dtype=float)\n",
    "    order = np.argsort(np.abs(attr))[-k:][::-1]\n",
    "    return pd.DataFrame(\n",
    "        {\n",
    "            \"rank\": np.arange(1, len(order) + 1),\n",
    "            \"row\": order // 28,\n",
    "            \"col\": order % 28,\n",
    "            \"attribution\": attr[order],\n",
    "            \"abs_attribution\": np.abs(attr[order]),\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "def rows_table(rows, columns=None, n=10):\n",
    "    table = pd.DataFrame(list(rows))\n",
    "    if columns is not None:\n",
    "        table = table[[col for col in columns if col in table.columns]]\n",
    "    return table.head(n)"
   ]
