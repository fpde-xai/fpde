      "source": [
        "selection = engine.select_lambda(\n",
        "    X_val[:80],\n",
        "    lambda_hyb_grid=LAMBDA_GRID,\n",
        "    fractions=FRACTIONS,\n",
        "    max_working_bytes=128 * 1024 * 1024,\n",
        ")\n",
        "\n",
        "assert len(selection.rows) > 0\n",
        "print(\"Best lambda:\", selection.best_lambda)\n",
        "print(\"Best config:\", selection.best_config)\n",
        "rows_table(\n",
        "    selection.sorted_rows(),\n",
        "    columns=[\"candidate_id\", \"lambda_hyb\", \"score\", \"mean_deletion_drop_auc\", \"mean_insertion_auc\", \"mean_evidence\"],\n",
        "    n=10,\n",
        ")"
      ]
    },
