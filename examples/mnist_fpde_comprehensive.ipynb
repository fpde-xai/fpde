      "source": [
        "## Small plotting helpers"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 3,
      "metadata": {},
      "outputs": [],
      "source": [
        "def as_image(vector):\n",
        "    return np.asarray(vector, dtype=float).reshape(28, 28)\n",
        "\n",
        "\n",
        "def show_digit(vector, *, title=None, ax=None, cmap=\"gray\"):\n",
        "    if ax is None:\n",
        "        _, ax = plt.subplots(figsize=(3, 3))\n",
        "    ax.imshow(as_image(vector), cmap=cmap, interpolation=\"nearest\")\n",
        "    ax.set_xticks([])\n",
        "    ax.set_yticks([])\n",
        "    if title is not None:\n",
        "        ax.set_title(title)\n",
        "    return ax\n",
        "\n",
        "\n",
        "def show_attribution(attributions, *, title=None, ax=None):\n",
        "    values = as_image(attributions)\n",
        "    max_abs = float(np.max(np.abs(values)))\n",
        "    if max_abs == 0.0 or not np.isfinite(max_abs):\n",
        "        max_abs = 1.0\n",
        "    if ax is None:\n",
        "        _, ax = plt.subplots(figsize=(3.4, 3))\n",
        "    image = ax.imshow(values, cmap=\"coolwarm\", vmin=-max_abs, vmax=max_abs, interpolation=\"nearest\")\n",
        "    ax.set_xticks([])\n",
        "    ax.set_yticks([])\n",
        "    if title is not None:\n",
        "        ax.set_title(title)\n",
        "    plt.colorbar(image, ax=ax, fraction=0.046, pad=0.04)\n",
        "    return ax\n",
        "\n",
        "\n",
        "def top_pixels(attributions, k=12):\n",
        "    attr = np.asarray(attributions, dtype=float)\n",
        "    order = np.argsort(np.abs(attr))[-k:][::-1]\n",
        "    return pd.DataFrame(\n",
        "        {\n",
        "            \"rank\": np.arange(1, len(order) + 1),\n",
        "            \"row\": order // 28,\n",
        "            \"col\": order % 28,\n",
        "            \"attribution\": attr[order],\n",
        "            \"abs_attribution\": np.abs(attr[order]),\n",
        "        }\n",
        "    )\n",
        "\n",
        "\n",
        "def rows_table(rows, columns=None, n=10):\n",
        "    table = pd.DataFrame(list(rows))\n",
        "    if columns is not None:\n",
        "        table = table[[col for col in columns if col in table.columns]]\n",
        "    return table.head(n)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## LightGBM black-box helper\n",
        "\n",
        "This mirrors the experimental runner's pattern: fit LightGBM on a DataFrame with stable feature names, then wrap predictions so FPDE can freely pass NumPy arrays into `predict_proba`."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 4,
      "metadata": {},
      "outputs": [],
      "source": [
        "class FeatureNameSafePredictor:\n",
        "    def __init__(self, model, feature_names):\n",
        "        self.model = model\n",
        "        self.raw_model = model\n",
        "        self.feature_names = [str(name) for name in feature_names]\n",
        "        self.classes_ = np.asarray(model.classes_)\n",
        "\n",
        "    def _as_feature_frame(self, X):\n",
        "        if isinstance(X, pd.DataFrame):\n",
        "            return X.loc[:, self.feature_names]\n",
        "        arr = np.asarray(X, dtype=float)\n",
        "        if arr.ndim == 1:\n",
        "            arr = arr.reshape(1, -1)\n",
        "        if arr.ndim != 2:\n",
        "            raise ValueError(f\"expected 1D or 2D input, got shape={arr.shape}\")\n",
        "        if arr.shape[1] != len(self.feature_names):\n",
        "            raise ValueError(f\"feature dimension mismatch: expected {len(self.feature_names)}, got {arr.shape[1]}\")\n",
        "        return pd.DataFrame(arr, columns=self.feature_names)\n",
        "\n",
        "    def predict_proba(self, X):\n",
        "        return np.asarray(self.model.predict_proba(self._as_feature_frame(X)), dtype=float)\n",
        "\n",
        "    def predict(self, X):\n",
        "        return np.asarray(self.model.predict(self._as_feature_frame(X)))\n",
        "\n",
        "    def __getattr__(self, name):\n",
        "        return getattr(self.model, name)\n",
        "\n",
        "\n",
        "def fit_lightgbm_blackbox(X_fit, y_fit):\n",
        "    from lightgbm import LGBMClassifier\n",
        "\n",
        "    feature_names = [f\"pixel_{row:02d}_{col:02d}\" for row in range(28) for col in range(28)]\n",
        "    X_fit_df = pd.DataFrame(np.asarray(X_fit, dtype=float), columns=feature_names)\n",
        "    raw_model = LGBMClassifier(\n",
        "        objective=\"multiclass\",\n",
        "        n_estimators=180,\n",
        "        learning_rate=0.05,\n",
        "        num_leaves=31,\n",
        "        subsample=0.9,\n",
        "        colsample_bytree=0.8,\n",
        "        random_state=RANDOM_STATE,\n",
        "        n_jobs=-1,\n",
        "        verbosity=-1,\n",
        "    )\n",
        "    raw_model.fit(X_fit_df, y_fit)\n",
        "    return FeatureNameSafePredictor(raw_model, feature_names)"
      ]
    },
